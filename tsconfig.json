{
  "compilerOptions": {
    "target": "es2022",
    "lib": [ "es2022" ],
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "out",
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
